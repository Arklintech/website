# ARKLINTECH Environment Configuration Example
# Copy to .env.local and fill in real values. NEVER commit .env.local to git.

# ── Google Sheets / Drive ─────────────────────────────────────────────────────
GOOGLE_PROJECT_ID="your-google-project-id"
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID="your-google-spreadsheet-id"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# ── Firebase (client-side, safe to expose via NEXT_PUBLIC_) ───────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── ARKLINTECH COMMAND Admin Authorization (SERVER-SIDE ONLY) ─────────────────
# Primary gate: comma-separated Firebase UIDs authorized for COMMAND Admin access.
# Valid Firebase token + UID NOT in this list → 403 Forbidden.
# DO NOT prefix with NEXT_PUBLIC_ — must never reach the browser bundle.
ADMIN_UID_ALLOWLIST="your-firebase-admin-uid-here"

# Secondary fallback (only used if ADMIN_UID_ALLOWLIST is empty):
ADMIN_AUTH_EMAIL="your-firebase-admin-email@example.com"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://arklintech.com"
FIREBASE_PROJECT_ID="your-firebase-project-id"
